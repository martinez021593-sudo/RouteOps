# RouteOps V0.3.0 — Internet Pilot
# Local: DATABASE_URL can be omitted and SQLite will be used.
# Cloud: Render injects DATABASE_URL automatically from PostgreSQL.

SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=
ROUTEOPS_TIMEZONE=Europe/Madrid
SESSION_COOKIE_SECURE=0
SEED_DEMO_DATA=1

# Bootstrap accounts used only if the database is empty.
BOOTSTRAP_ADMIN_EMAIL=admin@routeops.local
BOOTSTRAP_ADMIN_PASSWORD=demo123
BOOTSTRAP_DRIVER_PASSWORD=1234

# Optional Google integrations (not required for Internet Pilot)
GOOGLE_MAPS_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
DEPOT_LAT=
DEPOT_LON=

# Multi-Carrier Intake
GOOGLE_VISION_API_KEY=
AUTO_OPTIMIZE_INTAKE=1
STORE_INTAKE_IMAGES=0

# Pilot parser diagnostics (raw OCR returned to authenticated device only; not persisted)
INTAKE_OCR_DEBUG=1
# Required for coordinates / route optimization; separate from Vision OCR key
GOOGLE_MAPS_API_KEY=
