# Seguridad local
SECRET_KEY=cambia-esta-clave

# Zona horaria de la operación
ROUTEOPS_TIMEZONE=Europe/Madrid

# Geocodificación (opcional)
GOOGLE_MAPS_API_KEY=

# Optimización vial Google Route Optimization API (opcional)
# Debes habilitar Route Optimization API y billing en Google Cloud.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=C:\ruta\a\service-account.json

# Depósito / punto de salida y regreso. Si se omite, RouteOps usa el centro del lote.
DEPOT_LAT=
DEPOT_LON=

# V0.3 Cloud-ready (opcional)
# En un servidor con disco persistente, apunta aquí la base y las evidencias.
ROUTEOPS_DATA_DIR=
# Activa cookies Secure únicamente cuando el sitio se sirve por HTTPS público.
ROUTEOPS_SECURE_COOKIES=0
